# Sekret Django (wygeneruj nowy przez: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=twoj-tajny-klucz-django

# Tryb debugowania (True dla lokalnego dev, False dla produkcji)
DEBUG=True

# Konfiguracja bazy danych MariaDB
DB_NAME=omnipost
DB_USER=omnipost_user
DB_PASSWORD=twoje_bardzo_bezpieczne_haslo
DB_ROOT_PASSWORD=haslo_roota_bazy
DB_HOST=db
DB_PORT=3306

# Katalog na pliki multimedialne (WYMAGANE przez settings.py)
UPLOAD_ROOT=/app/media